.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Large or generated artifacts
artifacts/datasets/synthetic_v*/data/
artifacts/datasets/synthetic_v*/output/
!artifacts/datasets/.gitkeep
artifacts/corpora/*/raw/*
artifacts/corpora/*/extracted/*
artifacts/corpora/*/normalized/*
artifacts/corpora/*/audited/*
artifacts/corpora/*/filtered/*
artifacts/corpora/*/deduplicated/*
artifacts/corpora/*/contamination/*
artifacts/corpora/*/splits/*
!artifacts/corpora/**/.gitkeep
!artifacts/corpora/*/manifests/*.json
!artifacts/corpora/*/reports/*.json
artifacts/models/*
!artifacts/models/.gitkeep
!artifacts/models/*/
artifacts/models/*/*
!artifacts/models/*/model_manifest.json
runs/*
!runs/.gitkeep
logs/*
!logs/.gitkeep

# Hugging Face caches and checkpoints
.cache/
hf_cache/
checkpoints/
*.safetensors
*.bin
*.pt
*.pth

# Evaluation outputs
*.parquet
errors.jsonl
progress.json
artifacts/pre_m2_followup_v1/

# Workspace migration: secrets and local orchestration evidence
ssh-client/.env
.agents/STOP
.agents/runs/
.agents/state/

# Workspace migration: reproducible local build/runtime state
.tmp/
tmp/
output/
outputs/
**/*.inspect.ndjson

# Reference PDFs are preserved locally and hash-inventoried. Publication or
# Git LFS inclusion requires a separate copyright/license decision.
papers/**/*.pdf

# LaTeX build products; source, bibliography, data, and authored figures stay tracked.
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.log
paper/**/*.out
paper/**/main.pdf
